# ─────────────────────────────────────────────────────────────────────────────
# IBM Bob / watsonx.ai
# ─────────────────────────────────────────────────────────────────────────────
# Your Bob API key — get it from https://bob.ibm.com → Settings → API Keys
# Required for PDF/DOCX parsing and portfolio copy generation.
BOB_API_KEY=

# Path to the bob binary (default: "bob" assumes it's on PATH).
# On Vercel, leave this empty — PDF/DOCX parsing falls back gracefully.
BOB_PATH=bob

# ─────────────────────────────────────────────────────────────────────────────
# Vercel Blob  (optional — used for image uploads / headshots)
# ─────────────────────────────────────────────────────────────────────────────
# Create a Blob store in your Vercel project dashboard and paste the token here.
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# App URL
# ─────────────────────────────────────────────────────────────────────────────
# Set to your Vercel deployment URL in production, e.g. https://my-app.vercel.app
# Leave empty locally — Next.js uses http://localhost:3000 by default.
NEXT_PUBLIC_BASE_URL=
